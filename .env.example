# GitHub token for scripts/fetch.py only (public repos, read-only). If unset, the
# fetcher falls back to `gh auth token`. The app itself never calls GitHub.
GITHUB_TOKEN=

# FalkorDB image; drop back to falkordb/falkordb:v4.22.0 if 6.0 misbehaves.
FALKORDB_IMAGE=falkordb/falkordb:6.0.2
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Salt for contributor pseudonyms. Never commit the real value.
PSEUDONYM_SALT=change-me

# Free model key for the agent (console.groq.com, no card). Without it the agent still
# answers by running the obvious tools; everything else works the same.
GROQ_API_KEY=

# The graph the app serves, and the memory id the MCP server writes findings under.
UNDERSTUDY_GRAPH=org
UNDERSTUDY_VISITOR=mcp
